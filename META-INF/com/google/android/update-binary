#!/sbin/sh

# This is the Magisk installer entrypoint. KernelSU / APatch use their own
# module installer; this file is not their primary path. Keep Magisk v20.4+
# checks here and verify KSU/APatch on real devices before changing them.
umask 022

ui_print() { echo "$1"; }

require_new_magisk() {
  ui_print "*******************************"
  ui_print " Please install Magisk v20.4+! "
  ui_print "*******************************"
  exit 1
}

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && require_new_magisk

install_module
HK_RC=$?
exit "$HK_RC"
